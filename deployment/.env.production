# HomeOS Production Environment Configuration

# ======================
# aepbase Configuration
# ======================
# Upstream aepbase URL the Next.js `/api/aep` proxy forwards to.
# For local deployment leave as localhost; for Tailscale, use the host's
# Tailscale name or IP.
AEPBASE_URL=http://127.0.0.1:8090

# Alternative: Use Tailscale hostname for remote access
# AEPBASE_URL=http://your-tailscale-hostname:8090

# ======================
# App Configuration
# ======================
NEXT_PUBLIC_APP_NAME=HomeOS

# ======================
# Web Push Notifications
# ======================
# IMPORTANT: Generate your own VAPID keys using:
#   npx web-push generate-vapid-keys
#
# Public key (exposed to frontend)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=YOUR_VAPID_PUBLIC_KEY_HERE

# Server-side VAPID keys (for API routes)
# IMPORTANT: Keep VAPID_PRIVATE_KEY secret! Never commit real values to git
VAPID_PUBLIC_KEY=YOUR_VAPID_PUBLIC_KEY_HERE
VAPID_PRIVATE_KEY=YOUR_VAPID_PRIVATE_KEY_HERE
VAPID_EMAIL=mailto:admin@example.com

# ======================
# Gemini AI API Key
# ======================
GEMINI_API_KEY=your_gemini_api_key_here

# ======================
# aepbase Superuser Credentials
# ======================
# Used by the boot-time schema sync and server routes that need admin access.
# Printed to aepbase's stdout on first start.
AEPBASE_ADMIN_EMAIL=admin@example.com
AEPBASE_ADMIN_PASSWORD=your_admin_password_here

# ======================
# Notes
# ======================
# 1. Copy this file to frontend/.env for production deployment
# 2. Update AEPBASE_URL to match your deployment setup
# 3. Generate and set your own VAPID keys for web push notifications
# 4. Set AEPBASE_ADMIN_EMAIL/AEPBASE_ADMIN_PASSWORD from aepbase's first-run output
# 5. Never commit the actual .env file to version control
