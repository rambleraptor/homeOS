[Unit]
Description=Homestead (single-binary launcher: aepbase + sidecar + SPA)
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=homeosuser
WorkingDirectory=/path/to/homeOS
# The single binary embeds the SPA + Bun sidecar + aepbase. It spawns aepbase
# as a child process and serves the sidecar in-process. --data-dir keeps the
# sqlite db + uploaded files where the previous service wrote them, so data
# carries over.
ExecStart=/path/to/homeOS/bin/homestead start --port 3000 --data-dir /path/to/homeOS/aepbase/data
Restart=on-failure
RestartSec=5s

# VAPID + Gemini secrets for the Bun sidecar (notifications + OCR), plus any
# OAuth client secrets read by homestead.config.ts. The child processes inherit
# this environment.
EnvironmentFile=/path/to/homeOS/packages/homestead-app/.env

# homestead extracts its embedded aepbase binary to this cache dir before exec;
# pin it inside the repo so it stays writable under ProtectSystem=strict.
Environment="HOMESTEAD_CACHE_DIR=/path/to/homeOS/deployment/.cache"

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/path/to/homeOS/aepbase/data /path/to/homeOS/deployment/.cache

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
