# aepbase Configuration
# The browser talks to same-origin `/api/aep` (see next.config.ts rewrites).
# Override the backend the proxy points at by setting AEPBASE_URL.
# AEPBASE_URL=http://127.0.0.1:8090

# App Configuration
NEXT_PUBLIC_APP_NAME=Homestead

# Web Push Notifications
# Generate your own VAPID keys using: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=BEL8xH1kLqr8C9F0b3X7Y_Z5K6J4W8Q2M1N3P5R7T9V0A2C4E6G8I0K2M4O6Q8S0U2W4Y6A8C0E2G4I6K8M0O2

# Server-side VAPID keys (for API routes)
# IMPORTANT: Keep VAPID_PRIVATE_KEY secret! Never commit real values to git
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_EMAIL=mailto:admin@example.com

# Gemini AI API Key for grocery categorization (server-side only)
# Get your API key from: https://makersuite.google.com/app/apikey
# Note: This is NOT prefixed with NEXT_PUBLIC_ to keep it server-side only for security
GEMINI_API_KEY=your_gemini_api_key_here

# aepbase superuser credentials. Required for the boot-time schema sync
# (frontend/src/instrumentation.ts) and any server route that needs admin
# access. Printed to aepbase's stdout on first start.
AEPBASE_ADMIN_EMAIL=admin@example.com
AEPBASE_ADMIN_PASSWORD=your_admin_password_here

# ---------------------------------------------------------------------------
# OAuth login (optional) — handled by the homestead launcher
# ---------------------------------------------------------------------------
# When OAUTH_PROVIDERS is set, the launcher enables aepbase OAuth and the login
# page shows a "Sign in with <provider>" button per entry. By default login is
# existing-users-only: the provider's email must match a user an admin already
# created (POST /users). Set "allow_registration": true on a provider to let
# first-time sign-ins create a new account.
#
# OAUTH_PROVIDERS is a JSON array. aepbase does no OIDC discovery, so the
# authorize/token/userinfo endpoints are explicit. The values below are
# Google's; any OAuth2/OIDC provider (GitHub, etc.) works with its own URLs.
# OAUTH_PROVIDERS=[{"name":"google","display_name":"Google","client_id":"YOUR_CLIENT_ID","client_secret":"YOUR_CLIENT_SECRET","scopes":["openid","email","profile"],"auth_url":"https://accounts.google.com/o/oauth2/v2/auth","token_url":"https://oauth2.googleapis.com/token","userinfo_url":"https://openidconnect.googleapis.com/v1/userinfo"}]
#
# Externally-reachable base URL that maps to the aepbase root (app origin +
# /api/aep). Each provider's redirect_uri is built as:
#   {OAUTH_REDIRECT_BASE_URL}/oauth/{name}/callback
# Register that exact URL in the provider's console.
# OAUTH_REDIRECT_BASE_URL=http://localhost:3000/api/aep
#
# SPA URL the callback returns to with the minted token in the fragment.
# OAUTH_SUCCESS_REDIRECT=http://localhost:3000/auth/callback
