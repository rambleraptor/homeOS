{
  "extends": "@rambleraptor/homestead-app/tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@homestead-config": ["./homestead.config.ts"]
    }
  },
  "include": [
    "next-env.d.ts",
    "homestead.config.ts",
