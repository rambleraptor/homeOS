# Environment files
.env
.env.local
.env.*.local

# Sidecar extraction cache (homestead start writes the embedded sidecar here)
deployment/.cache/

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/*
!.vscode/extensions.json
.idea
*.swp
*.swo
*~

# Temporary files
*.tmp
*.temp

# Workspace node_modules (root-hoisted)
node_modules/

# Scripts
scripts/node_modules/

aepbase/terraform/terraform.lock.hcl

# homestead single-binary launcher output (built by `make homestead` / `release`)
# Anchored to the repo root so it does NOT match packages/*/bin/ (e.g. the
# homestead-cli npm entrypoint at packages/homestead-cli/bin/homestead.mjs).
/bin/

# Built SPA (embedded into the homestead binary by `make homestead`)
packages/homestead-app/dist/
packages/homestead-site/dist/
packages/homestead-site/.astro/
packages/homestead-site/docs/.vitepress/dist/
packages/homestead-site/docs/.vitepress/cache/

# Browser verification output
.playwright-mcp/
homestead-site-*.png

# homestead-cli build artifacts (compiled sidecar/aepbase, etc.)
packages/homestead-cli/.build/
